# DIMACS exports of the large Ramsey instances (regenerate with scripts/run_sat.sh)
dimacs/
*.cnf

# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.eggs/

# Environments
.venv/
venv/
env/

# Tooling
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Local run logs; runs/full_run.log and runs/hunt_driver.log are the raw evidence
# quoted by RESULTS.md and are deliberately committed.
*.log
!runs/full_run.log
!runs/hunt_driver.log

# A cube-and-conquer workdir: the CNF is regenerated from the instance in under a
# second, so it is not kept, while the cube file (the partition, which is what the
# cover check reads back) and the per-leaf rows are — the rows are what `--combine`
# re-reads, so a campaign whose result is quoted has to keep them to stay
# checkable offline.  The one exception below is the K97 run of RESULTS.md §9b.
runs/*/*.cnf
runs/*/rows/
!runs/cube_k97_d12/rows/
!runs/cube_k97_d12_pass2/rows/

# Lean build artifacts; the Lean sources live in lean/ and their toolchain is
# pinned by lean/lean-toolchain
lean/.lake/
lean/build/

# The raw SmallGroups exports written by scripts/gap_export_smallgroups.g.  They
# are reproducible (the GAP version and the digest of each part are recorded in
# data/smallgroups_<n>.json) and bulky; the checked portfolio built from them is
# committed, and that is what a sweep reads.
data/gap/
