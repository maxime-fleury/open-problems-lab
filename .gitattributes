# Everything in this repository is plain text and is written with LF endings.
# (The Lean sources, the shell scripts and the CI workflow are all read on
# Linux runners; CRLF in a .sh file would break them.)
* text=auto eol=lf
*.lean text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.md text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.cff text eol=lf
*.cnf -text
